{
  "name": "@soa/cli",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "soa": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "clean": "rm -rf dist",
    "start": "node dist/cli.js",
    "tui": "node dist/cli.js",
    "tui:exec": "node dist/cli.js tui exec",
    "tui:heae": "node dist/cli.js tui heae",
    "tui:memory": "node dist/cli.js tui memory",
    "tui:orch": "node dist/cli.js tui orch",
    "tui:menu": "node dist/cli.js tui menu",
    "tui:help": "node dist/cli.js tui help"
  },
  "dependencies": {
    "@soa/contracts": "workspace:*",
    "@soa/eval-harness": "workspace:*",
    "@soa/memory-agent": "workspace:*",
    "@soa/mocks": "workspace:*",
    "@soa/orchestrator": "workspace:*",
    "@soa/store": "workspace:*"
  }
}
