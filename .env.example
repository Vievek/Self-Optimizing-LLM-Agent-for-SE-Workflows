# ==============================================================================
# Self-Optimizing LLM Agent - Environment Configuration
# ==============================================================================

# Groq API Key & Multi-Key Failover Pool (Testing configuration)
# Define GROQ_KEY_COUNT and corresponding GROQ_API_KEY_N entries for auto-failover & 24h cooldown
GROQ_KEY_COUNT=3
GROQ_API_KEY_1=your_first_groq_key_here
GROQ_API_KEY_2=your_second_groq_key_here
GROQ_API_KEY_3=your_third_groq_key_here

# Single Groq API Key fallback (used if GROQ_KEY_COUNT is not specified)
GROQ_API_KEY=your_groq_api_key_here

# Google Gemini API Key (Optional fallback)
# Get a key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Hugging Face User Access Token (For Qwen2.5-Coder production router)
# Get a token at: https://huggingface.co/settings/tokens
HF_TOKEN=your_hf_token_here

# Optional: Path to custom models configuration YAML
# Set to 'packages/llm/models.testing.yaml' to test with Gemini
MODELS_CONFIG_PATH=packages/llm/models.testing.yaml

